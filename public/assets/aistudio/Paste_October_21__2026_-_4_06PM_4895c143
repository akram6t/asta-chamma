  <script>
    /*************************************************************************
- ASTA CHAMMA (CHINNATA | 5 HOUSES) — COMPLETE TRADITIONAL RULES ENGINE
     *************************************************************************/

    // Outer perimeter anti-clockwise ring (16 cells, starting from South (4,2))
    const OUTER_CCW = [
      [4,2], [4,3], [4,4], [3,4],
      [2,4], [1,4], [0,4], [0,3],
      [0,2], [0,1], [0,0], [1,0],
      [2,0], [3,0], [4,0], [4,1]
    ];

    // Inner 3x3 clockwise ring (8 cells, starting from South-West inner entry (3,1))
    const INNER_CW = [
      [3,1], [2,1], [1,1], [1,2],
      [1,3], [2,3], [3,3], [3,2]
    ];

    // Build the 25-step spiral path (indices 0..24) for each of the 4 Houses
    // Player 0: South (4,2) — Orange
    // Player 1: East  (2,4) — Teal/Green
    // Player 2: North (0,2) — Blue
    // Player 3: West  (2,0) — Purple
    function buildPlayerPath(playerIdx) {
      const outerOffset = playerIdx * 4; // 0, 4, 8, 12
      // Inner entry cell is clockwise around the inner ring:
      // South enters at (3,1) [idx 0], East enters at (3,3) [idx 6],
      // North enters at (1,3) [idx 4], West enters at (1,1) [idx 2]
      const innerOffsets = [0, 6, 4, 2];
      const inOffset = innerOffsets[playerIdx];

      const path = [];
      for (let i = 0; i < 16; i++) {
        path.push(OUTER_CCW[(outerOffset + i) % 16]);
      }
      for (let i = 0; i < 8; i++) {
        path.push(INNER_CW[(inOffset + i) % 8]);
      }
      path.push([2, 2]); // Step 24: Central Ashoka Chakra Sanctuary
      return path;
    }

    const PLAYER_PATHS = [
      buildPlayerPath(0),
      buildPlayerPath(1),
      buildPlayerPath(2),
      buildPlayerPath(3)
    ];

    const SAFE_CELLS = new Set(['4,2', '2,4', '0,2', '2,0', '2,2']);

    function isSafeCell(r, c) {
      return SAFE_CELLS.has(r + ',' + c);
    }

    const HOUSE_DEFS = [
      {
        id: 0,
        name: 'South House',
        gemName: 'Saffron Orange',
        short: 'Orange (S)',
        homeCoord: [4, 2],
        primary: '#ea580c',
        light: '#fb923c',
        dark: '#9a3412',
        badgeClass: 'border-orange-500/50 bg-orange-950/30 text-orange-200'
      },
      {
        id: 1,
        name: 'East House',
        gemName: 'Turquoise Green',
        short: 'Teal (E)',
        homeCoord: [2, 4],
        primary: '#0d9488',
        light: '#2dd4bf',
        dark: '#115e59',
        badgeClass: 'border-teal-500/50 bg-teal-950/30 text-teal-200'
      },
      {
        id: 2,
        name: 'North House',
        gemName: 'Cobalt Blue',
        short: 'Blue (N)',
        homeCoord: [0, 2],
        primary: '#2563eb',
        light: '#60a5fa',
        dark: '#1e3a8a',
        badgeClass: 'border-blue-500/50 bg-blue-950/30 text-blue-200'
      },
      {
        id: 3,
        name: 'West House',
        gemName: 'Amethyst Purple',
        short: 'Purple (W)',
        homeCoord: [2, 0],
        primary: '#7e22ce',
        light: '#c084fc',
        dark: '#581c87',
        badgeClass: 'border-purple-500/50 bg-purple-950/30 text-purple-200'
      }
    ];

    // Synthesized Web Audio API Sound Engine
    let soundEnabled = true;
    let audioCtx = null;

    function ensureAudio() {
      if (!soundEnabled) return null;
      if (!audioCtx) {
        const AudioContextClass = window.AudioContext || window.webkitAudioContext;
        if (AudioContextClass) audioCtx = new AudioContextClass();
      }
      if (audioCtx && audioCtx.state === 'suspended') {
        audioCtx.resume();
      }
      return audioCtx;
    }

    function playSound(type) {
      const ctx = ensureAudio();
      if (!ctx) return;
      const now = ctx.currentTime;

      if (type === 'shells') {
        // 4 crisp cowrie clacks
        [0, 0.055, 0.11, 0.16].forEach((offset, idx) => {
          const osc = ctx.createOscillator();
          const gain = ctx.createGain();
          osc.type = 'triangle';
          osc.frequency.setValueAtTime(520 + idx * 140, now + offset);
          osc.frequency.exponentialRampToValueAtTime(190, now + offset + 0.045);
          gain.gain.setValueAtTime(0.16, now + offset);
          gain.gain.exponentialRampToValueAtTime(0.001, now + offset + 0.045);
          osc.connect(gain);
          gain.connect(ctx.destination);
          osc.start(now + offset);
          osc.stop(now + offset + 0.05);
        });
      } else if (type === 'step') {
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.type = 'sine';
        osc.frequency.setValueAtTime(340, now);
        osc.frequency.exponentialRampToValueAtTime(520, now + 0.08);
        gain.gain.setValueAtTime(0.14, now);
        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.085);
        osc.connect(gain);
        gain.connect(ctx.destination);
        osc.start(now);
        osc.stop(now + 0.09);
      } else if (type === 'cut') {
        [440, 587.33, 880].forEach((freq, i) => {
          const osc = ctx.createOscillator();
          const gain = ctx.createGain();
          osc.type = 'sawtooth';
          osc.frequency.setValueAtTime(freq, now + i * 0.06);
          gain.gain.setValueAtTime(0.12, now + i * 0.06);
          gain.gain.exponentialRampToValueAtTime(0.001, now + i * 0.06 + 0.16);
          osc.connect(gain);
          gain.connect(ctx.destination);
          osc.start(now + i * 0.06);
          osc.stop(now + i * 0.06 + 0.17);
        });
      } else if (type === 'home') {
        [523.25, 659.25, 783.99, 1046.5].forEach((freq, i) => {
          const osc = ctx.createOscillator();
          const gain = ctx.createGain();
          osc.type = 'triangle';
          osc.frequency.setValueAtTime(freq, now + i * 0.08);
          gain.gain.setValueAtTime(0.15, now + i * 0.08);
          gain.gain.exponentialRampToValueAtTime(0.001, now + i * 0.08 + 0.25);
          osc.connect(gain);
          gain.connect(ctx.destination);
          osc.start(now + i * 0.08);
          osc.stop(now + i * 0.08 + 0.26);
        });
      }
    }

    // Game State
    const state = {
      mode: '1p_4', // '1p_4', '1p_2', 'pass_4', 'pass_2'
      rules: {
        bloodGate: true,   // Must cut at least 1 opponent pawn to enter inner 3x3 ring
        doubles: true,     // 2 friendly pawns on an unsafe cell form a protected Double & block single enemy pass
        threeBust: false   // 3 consecutive 4/8 rolls bust the turn
      },
      players: [],
      turnIndex: 0,
      phase: 'ROLL',       // 'ROLL' | 'MOVE' | 'GAMEOVER'
      rollPool: [],        // Array of { id, value, used }
      selectedRollId: null,
      consecutiveHighRolls: 0,
      pairMoveMode: false, // Move 2 stacked pawns together as a Double
      lastShells: [1, 1, 0, 1], // 1 = mouth up, 0 = hump up
      lastRollText: 'Cast cowries to begin',
      pathPreviewPlayer: -1, // -1 means current turn player
      showStepNumbers: false,
      hoveredPawn: null,     // { playerIdx, pawnIdx }
      aiTimer: null
    };

    function createInitialPlayers() {
      const activeIds = (state.mode === '1p_2' || state.mode === 'pass_2') ? [0, 2] : [0, 1, 2, 3];
      return HOUSE_DEFS.map((def, idx) => {
        const isActive = activeIds.includes(idx);
        const isAI = isActive && (
          (state.mode === '1p_4' && idx !== 0) ||
          (state.mode === '1p_2' && idx !== 0)
        );
        return {
          ...def,
          active: isActive,
          isAI: isAI,
          hasHit: !state.rules.bloodGate, // Unlocked immediately only if bloodGate rule is OFF
          cutsMade: 0,
          // Each pawn starts at stepIndex 0 (on the player's crossed Home square, matching the photo!)
          // and tracks outerLaps if orbiting while Blood Gate is locked.
          pawns: [0, 1, 2, 3].map(pId => ({
            id: pId,
            step: 0,       // 0..24 (24 = Center Chakra Home)
            finished: false
          }))
        };
      });
    }

    function initMatch() {
      if (state.aiTimer) {
        clearTimeout(state.aiTimer);
        state.aiTimer = null;
      }
      state.players = createInitialPlayers();
      state.turnIndex = 0;
      state.phase = 'ROLL';
      state.rollPool = [];
      state.selectedRollId = null;
      state.consecutiveHighRolls = 0;
      state.pairMoveMode = false;
      state.lastShells = [1, 0, 1, 1];
      state.lastRollText = 'Ready to Cast';
      state.hoveredPawn = null;

      document.getElementById('victoryModal').classList.add('hidden');
      document.getElementById('moveLogList').innerHTML = '';
      addLog('✨ New 5-House Asta Chamma (Chinnata) match started. All 4 pawns per house begin on their crossed Safe House (Step 0).', 'system');
      updateUI();
      drawBoard();
    }

    function addLog(msg, tone = 'normal') {
      const list = document.getElementById('moveLogList');
      const item = document.createElement('div');
      let cls = 'text-stone-300 bg-stone-950/60 border-stone-800';
      if (tone === 'cut') cls = 'text-rose-200 bg-rose-950/40 border-rose-700/50 font-medium';
      if (tone === 'bonus') cls = 'text-amber-200 bg-amber-950/40 border-amber-700/40';
      if (tone === 'home') cls = 'text-emerald-200 bg-emerald-950/40 border-emerald-700/50 font-semibold';
      if (tone === 'system') cls = 'text-stone-400 bg-stone-950/40 border-stone-800 italic';

      item.className = `px-2.5 py-1.5 rounded-lg border ${cls}`;
      item.textContent = msg;
      list.prepend(item);
    }

    // Get coordinates [r, c] for a player's pawn at a given step (0..24)
    function getPawnCoord(playerIdx, step) {
      return PLAYER_PATHS[playerIdx][step];
    }

    // Count pawns of each player at cell (r, c)
    function getCellOccupants(r, c) {
      const map = { 0: [], 1: [], 2: [], 3: [] };
      state.players.forEach(p => {
        if (!p.active) return;
        p.pawns.forEach(pawn => {
          const [pr, pc] = getPawnCoord(p.id, pawn.step);
          if (pr === r && pc === c) {
            map[p.id].push(pawn.id);
          }
        });
      });
      return map;
    }

    // Compute destination step and legality for moving `playerIdx`'s pawn from `startStep` by `rollVal`
    // Supports:
    // - Blood-Gate outer perimeter orbit when !player.hasHit and crossing step 15
    // - Exact count to step 24
    // - Double/Pair protection & outer blockade when state.rules.doubles is true
    function evaluateMove(playerIdx, pawnIdx, rollVal, asPair = false) {
      const player = state.players[playerIdx];
      const pawn = player.pawns[pawnIdx];
      if (!pawn || pawn.finished || pawn.step === 24) {
        return { valid: false, reason: 'Pawn already reached the center Chakra' };
      }

      const [startR, startC] = getPawnCoord(playerIdx, pawn.step);
      const startOccupants = getCellOccupants(startR, startC)[playerIdx];

      // If asPair is requested, verify at least 2 friendly pawns are at startStep (and not finished)
      if (asPair && startOccupants.length < 2) {
        return { valid: false, reason: 'Need 2 friendly pawns on the same square to move as a Double' };
      }
      const movingCount = asPair ? 2 : 1;

      // Trace step-by-step path for `rollVal` steps
      let curStep = pawn.step;
      const tracedSteps = [];

      for (let s = 1; s <= rollVal; s++) {
        let nextStep = curStep + 1;

        // Check transition at Step 15 (Inner Gate)
        if (curStep === 15) {
          if (player.hasHit || !state.rules.bloodGate) {
            nextStep = 16; // Enter inner clockwise loop!
          } else {
            // Blood-Gate is locked: continue orbiting the outer 16-cell perimeter!
            nextStep = 0;
          }
        } else if (curStep >= 16) {
          // Inside the inner ring (16..23) -> must land on 24 by exact count
          if (nextStep > 24) {
            return { valid: false, reason: 'Requires exact roll to enter the Center Sanctuary' };
          }
        }

        const [nr, nc] = getPawnCoord(playerIdx, nextStep);

        // Check Double Roadblock Rule on intermediate cells (s < rollVal)
        // On the outer ring, a single pawn cannot jump past an opponent's Double on an unsafe cell
        if (state.rules.doubles && s < rollVal && !isSafeCell(nr, nc) && movingCount === 1) {
          const occ = getCellOccupants(nr, nc);
          for (let oppId = 0; oppId < 4; oppId++) {
            if (oppId !== playerIdx && occ[oppId].length >= 2) {
              return { valid: false, reason: `Blocked by ${HOUSE_DEFS[oppId].short}'s Double at (${nr+1},${nc+1})` };
            }
          }
        }

        curStep = nextStep;
        tracedSteps.push(curStep);
      }

      const targetStep = curStep;
      const [tr, tc] = getPawnCoord(playerIdx, targetStep);
      const safe = isSafeCell(tr, tc);
      const targetOcc = getCellOccupants(tr, tc);

      // Check enemy pawns on the landing square
      let cutVictims = []; // Array of { oppId, pawnId }
      if (!safe) {
        for (let oppId = 0; oppId < 4; oppId++) {
          if (oppId === playerIdx) continue;
          const oppPawnsHere = targetOcc[oppId];
          if (oppPawnsHere.length > 0) {
            if (state.rules.doubles && oppPawnsHere.length >= 2 && movingCount === 1) {
              // Single pawn cannot land on or cut an opponent's Double!
              return { valid: false, reason: `A single pawn cannot cut ${HOUSE_DEFS[oppId].short}'s protected Double` };
            }
            // Capture! If moving as a Double onto a Double, cuts up to movingCount pawns; if single onto single, cuts the single
            const numToCut = movingCount >= 2 ? Math.min(oppPawnsHere.length, 2) : 1;
            for (let k = 0; k < numToCut; k++) {
              cutVictims.push({ oppId, pawnId: oppPawnsHere[k] });
            }
          }
        }
      }

      return {
        valid: true,
        startStep: pawn.step,
        targetStep,
        tracedSteps,
        targetCoord: [tr, tc],
        movingCount,
        partnerPawnId: asPair ? startOccupants.find(id => id !== pawnIdx) : null,
        cutVictims,
        isHomeFinish: targetStep === 24,
        formsDouble: !safe && (targetOcc[playerIdx].length + movingCount >= 2)
      };
    }

    // List all valid moves for the current player across all unused rolls in rollPool
    function getAllValidMovesForPlayer(playerIdx) {
      const unusedRolls = state.rollPool.filter(r => !r.used);
      const moves = [];
      unusedRolls.forEach(rollObj => {
        state.players[playerIdx].pawns.forEach(pawn => {
          // Single move check
          const resSingle = evaluateMove(playerIdx, pawn.id, rollObj.value, false);
          if (resSingle.valid) {
            moves.push({ rollObj, pawnId: pawn.id, asPair: false, eval: resSingle });
          }
          // Pair move check (if Doubles enabled)
          if (state.rules.doubles) {
            const resPair = evaluateMove(playerIdx, pawn.id, rollObj.value, true);
            if (resPair.valid) {
              moves.push({ rollObj, pawnId: pawn.id, asPair: true, eval: resPair });
            }
          }
        });
      });
      return moves;
    }

    // Cast the 4 Cowrie Shells (or force a specific roll value for testing)
    function castCowries(forcedValue = null) {
      if (state.phase !== 'ROLL') return;
      const player = state.players[state.turnIndex];

      playSound('shells');

      let shells = [0, 0, 0, 0];
      if (forcedValue === null) {
        shells = [0, 1, 2, 3].map(() => (Math.random() < 0.5 ? 1 : 0));
      } else {
        if (forcedValue === 1) shells = [1, 0, 0, 0];
        else if (forcedValue === 2) shells = [1, 1, 0, 0];
        else if (forcedValue === 3) shells = [1, 1, 1, 0];
        else if (forcedValue === 4) shells = [1, 1, 1, 1];
        else if (forcedValue === 8) shells = [0, 0, 0, 0];
        // Shuffle shells array so forced rolls look natural
        shells.sort(() => Math.random() - 0.5);
      }

      state.lastShells = shells;
      const mouthsUp = shells.reduce((a, b) => a + b, 0);
      const rollValue = mouthsUp === 0 ? 8 : mouthsUp;

      const rollNames = {
        1: 'Okkati / Dayam (1)',
        2: 'Rendu / Duga (2)',
        3: 'Moodu / Thiga (3)',
        4: 'CHAMMA / CHAUKA (4) 🌟',
        8: 'ASHTA / BARA (8) 🔥'
      };
      state.lastRollText = rollNames[rollValue];

      // Animate cowrie shells
      renderCowrieShells(true);

      const isBonusRoll = (rollValue === 4 || rollValue === 8);
      if (isBonusRoll) {
        state.consecutiveHighRolls += 1;
      } else {
        state.consecutiveHighRolls = 0;
      }

      // Check 3x Consecutive High-Roll Bust Rule (Moor Naak Shyam)
      if (state.rules.threeBust && state.consecutiveHighRolls >= 3) {
        addLog(`⚡ ${player.short} rolled three consecutive 4s/8s (Moor Naak Shyam)! Turn busts and passes.`, 'cut');
        state.rollPool = [];
        state.selectedRollId = null;
        endTurn();
        return;
      }

      // Add roll to pool
      const newRollObj = {
        id: 'r_' + Date.now() + '_' + Math.random().toString(36).slice(2, 6),
        value: rollValue,
        used: false
      };
      state.rollPool.push(newRollObj);
      if (!state.selectedRollId) {
        state.selectedRollId = newRollObj.id;
      }

      if (isBonusRoll) {
        addLog(`🐚 ${player.short} cast ${rollNames[rollValue]} — Bonus Throw earned!`, 'bonus');
        state.phase = 'ROLL'; // Can roll again before moving!
        updateUI();
        drawBoard();
        if (player.isAI) {
          scheduleAIMove();
        }
      } else {
        addLog(`🐚 ${player.short} cast ${rollNames[rollValue]}.`, 'normal');
        state.phase = 'MOVE';
        checkAutoPassOrMovePhase();
      }
    }

    function checkAutoPassOrMovePhase() {
      const player = state.players[state.turnIndex];
      const allValid = getAllValidMovesForPlayer(player.id);

      if (allValid.length === 0) {
        addLog(`⏭️ ${player.short} has no legal moves for [${state.rollPool.filter(r => !r.used).map(r => r.value).join(', ')}]. Turn passes.`, 'system');
        updateUI();
        drawBoard();
        setTimeout(() => {
          endTurn();
        }, 650);
        return;
      }

      // Ensure selectedRollId points to an unused roll
      const currentSelected = state.rollPool.find(r => r.id === state.selectedRollId && !r.used);
      if (!currentSelected) {
        const firstUnused = state.rollPool.find(r => !r.used);
        state.selectedRollId = firstUnused ? firstUnused.id : null;
      }

      updateUI();
      drawBoard();

      if (player.isAI) {
        scheduleAIMove();
      }
    }

    // Execute a validated move on the board
    function executePawnMove(playerIdx, pawnIdx, rollId, usePairMode) {
      const player = state.players[playerIdx];
      const rollObj = state.rollPool.find(r => r.id === rollId && !r.used);
      if (!rollObj) return false;

      // Try requested pair mode first; if invalid and usePairMode was true, fallback to single
      let moveEval = evaluateMove(playerIdx, pawnIdx, rollObj.value, usePairMode);
      if (!moveEval.valid && usePairMode) {
        moveEval = evaluateMove(playerIdx, pawnIdx, rollObj.value, false);
      }
      if (!moveEval.valid) return false;

      // Mark roll used
      rollObj.used = true;

      // Move primary pawn (and partner pawn if moving as a Double)
      const pawn = player.pawns[pawnIdx];
      pawn.step = moveEval.targetStep;
      if (pawn.step === 24) pawn.finished = true;

      if (moveEval.movingCount === 2 && moveEval.partnerPawnId !== null) {
        const partner = player.pawns[moveEval.partnerPawnId];
        partner.step = moveEval.targetStep;
        if (partner.step === 24) partner.finished = true;
      }

      // Handle Cuts / Captures!
      let earnedCutBonus = false;
      if (moveEval.cutVictims.length > 0) {
        earnedCutBonus = true;
        moveEval.cutVictims.forEach(victim => {
          const oppPlayer = state.players[victim.oppId];
          const oppPawn = oppPlayer.pawns[victim.pawnId];
          oppPawn.step = 0; // Sent back to starting Home cross!
          oppPawn.finished = false;
          player.cutsMade += 1;
          const unlockedNow = !player.hasHit;
          player.hasHit = true;
          addLog(
            `⚔️ ${player.short} CUT ${oppPlayer.short}'s pawn at (${moveEval.targetCoord[0]+1},${moveEval.targetCoord[1]+1})! ${unlockedNow ? '🔓 Inner Blood-Gate UNLOCKED & ' : ''}Bonus Throw awarded!`,
            'cut'
          );
        });
        playSound('cut');
      } else if (moveEval.isHomeFinish) {
        playSound('home');
        addLog(`☸️ ${player.short} brought ${moveEval.movingCount === 2 ? 'a Double pair' : 'a pawn'} home into the central Ashoka Chakra!`, 'home');
      } else {
        playSound('step');
        const label = moveEval.movingCount === 2 ? 'Double pair' : `Pawn #${pawnIdx + 1}`;
        const orbitNote = (moveEval.startStep <= 15 && moveEval.targetStep < moveEval.startStep)
          ? ' (continuing outer orbit — need 1 cut to enter inner ring)'
          : '';
        addLog(`${player.short} advanced ${label} by ${rollObj.value} to Step ${moveEval.targetStep}${orbitNote}.`, 'normal');
      }

      // Check Win Condition (all 4 pawns at Step 24)
      if (player.pawns.every(p => p.step === 24)) {
        state.phase = 'GAMEOVER';
        playSound('home');
        addLog(`🏆 VICTORY! ${player.name} (${player.gemName}) has brought all 4 pawns to the center sanctuary!`, 'home');
        showVictoryModal(player);
        updateUI();
        drawBoard();
        return true;
      }

      // If cut earned a bonus throw, switch back to ROLL phase so player can cast cowries!
      if (earnedCutBonus) {
        state.phase = 'ROLL';
        const nextUnused = state.rollPool.find(r => !r.used);
        state.selectedRollId = nextUnused ? nextUnused.id : null;
        updateUI();
        drawBoard();
        if (player.isAI) scheduleAIMove();
        return true;
      }

      // Check remaining unused rolls in pool
      const remainingUnused = state.rollPool.filter(r => !r.used);
      if (remainingUnused.length > 0) {
        state.selectedRollId = remainingUnused[0].id;
        checkAutoPassOrMovePhase();
      } else {
        endTurn();
      }
      return true;
    }

    function endTurn() {
      if (state.phase === 'GAMEOVER') return;
      state.rollPool = [];
      state.selectedRollId = null;
      state.consecutiveHighRolls = 0;
      state.phase = 'ROLL';

      // Advance to next active player
      for (let i = 1; i <= 4; i++) {
        const cand = (state.turnIndex + i) % 4;
        if (state.players[cand].active) {
          state.turnIndex = cand;
          break;
        }
      }

      updateUI();
      drawBoard();

      if (state.players[state.turnIndex].isAI) {
        scheduleAIMove();
      }
    }

    // Tactical AI Decision Engine
    function scheduleAIMove() {
      if (state.aiTimer) clearTimeout(state.aiTimer);
      state.aiTimer = setTimeout(() => {
        const player = state.players[state.turnIndex];
        if (!player || !player.isAI || state.phase === 'GAMEOVER') return;

        if (state.phase === 'ROLL') {
          castCowries();
          return;
        }

        if (state.phase === 'MOVE') {
          const allMoves = getAllValidMovesForPlayer(player.id);
          if (allMoves.length === 0) {
            endTurn();
            return;
          }

          // Score each candidate move tactically:
          // 1. Cutting an enemy pawn (+200, or +350 if Blood Gate is still locked!)
          // 2. Reaching Center Home Step 24 (+160)
          // 3. Landing on a Safe House X (+55)
          // 4. Forming a protective Double on an unsafe cell (+35)
          // 5. Entering the inner ring (+40)
          // 6. Advancing the furthest pawn (+step)
          let bestMove = allMoves[0];
          let bestScore = -9999;

          allMoves.forEach(m => {
            let score = m.eval.targetStep * 2;
            if (m.eval.cutVictims.length > 0) {
              score += (!player.hasHit ? 360 : 210) * m.eval.cutVictims.length;
            }
            if (m.eval.isHomeFinish) score += 170;
            const [tr, tc] = m.eval.targetCoord;
            if (isSafeCell(tr, tc) && m.eval.targetStep > 0) score += 55;
            if (m.eval.formsDouble) score += 35;
            if (m.eval.startStep <= 15 && m.eval.targetStep >= 16) score += 45;
            // Slight caution about leaving a safe cell unless cutting or finishing
            const [sr, sc] = getPawnCoord(player.id, m.eval.startStep);
            if (isSafeCell(sr, sc) && !isSafeCell(tr, tc) && m.eval.cutVictims.length === 0) {
              score -= 12;
            }
            if (score > bestScore) {
              bestScore = score;
              bestMove = m;
            }
          });

          executePawnMove(player.id, bestMove.pawnId, bestMove.rollObj.id, bestMove.asPair);
        }
      }, 620);
    }

    function showVictoryModal(winner) {
      const modal = document.getElementById('victoryModal');
      document.getElementById('victoryTitle').textContent = `${winner.name} (${winner.gemName}) Wins!`;
      document.getElementById('victorySub').textContent =
        `Completed the 25-step Chinnata spiral with ${winner.cutsMade} capture${winner.cutsMade === 1 ? '' : 's'}!`;
      modal.classList.remove('hidden');
    }

    /*************************************************************************
- CANVAS 2D RENDERER — KHADI BOARD, SAFE CROSSES, ASHOKA CHAKRA & PAWNS
     *************************************************************************/
    const canvas = document.getElementById('boardCanvas');
    const ctx = canvas.getContext('2d');

    // Store clickable hitboxes for pawns and cells during render
    let pawnHitboxes = []; // { playerIdx, pawnIdx, x, y, r, cellR, cellC }

    function drawBoard() {
      const W = canvas.width;
      const H = canvas.height;
      const pad = 12;
      const gridW = W - pad * 2;
      const cellS = gridW / 5;

      ctx.clearRect(0, 0, W, H);

      // 1. Subtle Khadi base fill inside grid
      ctx.fillStyle = '#f5f0e6';
      ctx.fillRect(pad, pad, gridW, gridW);

      // 2. Highlight active route path (either chosen pathPreviewPlayer or current turn player)
      const routePlayerIdx = state.pathPreviewPlayer === -1 ? state.turnIndex : state.pathPreviewPlayer;
      const routePath = PLAYER_PATHS[routePlayerIdx];
      const routeHouse = HOUSE_DEFS[routePlayerIdx];

      // Draw subtle spiral path ribbon
      ctx.save();
      ctx.strokeStyle = routeHouse.primary + '30';
      ctx.lineWidth = 10;
      ctx.lineCap = 'round';
      ctx.lineJoin = 'round';
      ctx.beginPath();
      routePath.forEach(([r, c], idx) => {
        const cx = pad + (c + 0.5) * cellS;
        const cy = pad + (r + 0.5) * cellS;
        if (idx === 0) ctx.moveTo(cx, cy);
        else ctx.lineTo(cx, cy);
      });
      ctx.stroke();
      ctx.restore();

      // 3. Draw 5x5 cells, Safe House diagonal crosses, and Inner Loop border accent
      for (let r = 0; r < 5; r++) {
        for (let c = 0; c < 5; c++) {
          const x = pad + c * cellS;
          const y = pad + r * cellS;

          // Subtle tint for inner 3x3 ring (r in 1..3, c in 1..3)
          if (r >= 1 && r <= 3 && c >= 1 && c <= 3 && !(r === 2 && c === 2)) {
            ctx.fillStyle = 'rgba(30, 58, 138, 0.04)';
            ctx.fillRect(x, y, cellS, cellS);
          }

          // Safe house diagonal crosses (4 outer homes + center square)
          if (isSafeCell(r, c)) {
            ctx.save();
            ctx.strokeStyle = '#172554';
            ctx.lineWidth = 3.5;
            ctx.beginPath();
            ctx.moveTo(x + 3, y + 3);
            ctx.lineTo(x + cellS - 3, y + cellS - 3);
            ctx.moveTo(x + cellS - 3, y + 3);
            ctx.lineTo(x + 3, y + cellS - 3);
            ctx.stroke();
            ctx.restore();
          }

          // Center square (2,2): Draw authentic 24-spoke Ashoka Chakra medallion in the center
          if (r === 2 && c === 2) {
            const cx = x + cellS / 2;
            const cy = y + cellS / 2;
            const chakraR = cellS * 0.25;

            ctx.save();
            ctx.fillStyle = '#f5f0e6';
            ctx.beginPath();
            ctx.arc(cx, cy, chakraR + 4, 0, Math.PI * 2);
            ctx.fill();

            ctx.strokeStyle = '#172554';
            ctx.lineWidth = 2.6;
            ctx.beginPath();
            ctx.arc(cx, cy, chakraR, 0, Math.PI * 2);
            ctx.stroke();

            ctx.lineWidth = 1.2;
            ctx.beginPath();
            ctx.arc(cx, cy, chakraR * 0.82, 0, Math.PI * 2);
            ctx.stroke();

            // 24 spokes
            for (let s = 0; s < 24; s++) {
              const ang = (s * Math.PI * 2) / 24;
              ctx.beginPath();
              ctx.moveTo(cx, cy);
              ctx.lineTo(cx + Math.cos(ang) * chakraR * 0.82, cy + Math.sin(ang) * chakraR * 0.82);
              ctx.stroke();
            }
            ctx.restore();
          }

          // Optional Step Number badge for routePlayerIdx
          if (state.showStepNumbers) {
            const stepIdx = routePath.findIndex(([pr, pc]) => pr === r && pc === c);
            if (stepIdx !== -1) {
              ctx.save();
              ctx.fillStyle = routeHouse.primary;
              ctx.font = 'bold 11px Inter, sans-serif';
              ctx.fillText('#' + stepIdx, x + 6, y + 15);
              ctx.restore();
            }
          }
        }
      }

      // 4. Draw Indigo Block-Print Grid Lines
      ctx.save();
      ctx.strokeStyle = '#172554';
      ctx.lineWidth = 4.5;
      ctx.strokeRect(pad, pad, gridW, gridW);

      ctx.lineWidth = 3.5;
      for (let i = 1; i < 5; i++) {
        // Horizontal
        ctx.beginPath();
        ctx.moveTo(pad, pad + i * cellS);
        ctx.lineTo(pad + gridW, pad + i * cellS);
        ctx.stroke();
        // Vertical
        ctx.beginPath();
        ctx.moveTo(pad + i * cellS, pad);
        ctx.lineTo(pad + i * cellS, pad + gridW);
        ctx.stroke();
      }

      // Highlight Inner 3x3 Gate Boundary with a subtle dashed gold inner frame
      ctx.strokeStyle = 'rgba(180, 83, 9, 0.45)';
      ctx.lineWidth = 2;
      ctx.setLineDash([6, 4]);
      ctx.strokeRect(pad + cellS + 2, pad + cellS + 2, cellS * 3 - 4, cellS * 3 - 4);
      ctx.restore();

      // 5. If in MOVE phase and a roll is selected, highlight legal destination squares and hovered pawn's path
      const activePlayer = state.players[state.turnIndex];
      const selectedRollObj = state.rollPool.find(r => r.id === state.selectedRollId && !r.used);
      const movablePawnIds = new Set();

      if (state.phase === 'MOVE' && selectedRollObj && activePlayer && !activePlayer.isAI) {
        activePlayer.pawns.forEach(p => {
          let ev = evaluateMove(activePlayer.id, p.id, selectedRollObj.value, state.pairMoveMode);
          if (!ev.valid && state.pairMoveMode) {
            ev = evaluateMove(activePlayer.id, p.id, selectedRollObj.value, false);
          }
          if (ev.valid) {
            movablePawnIds.add(p.id);
            // If this pawn is hovered (or all movable pawns), draw target highlight
            const isHovered = state.hoveredPawn &&
              state.hoveredPawn.playerIdx === activePlayer.id &&
              state.hoveredPawn.pawnIdx === p.id;

            const [tr, tc] = ev.targetCoord;
            const tx = pad + tc * cellS;
            const ty = pad + tr * cellS;

            ctx.save();
            ctx.fillStyle = ev.cutVictims.length > 0
              ? 'rgba(225, 29, 72, 0.24)'
              : 'rgba(16, 185, 129, 0.22)';
            ctx.fillRect(tx + 4, ty + 4, cellS - 8, cellS - 8);

            ctx.strokeStyle = ev.cutVictims.length > 0 ? '#e11d48' : '#059669';
            ctx.lineWidth = isHovered ? 3.5 : 2;
            ctx.strokeRect(tx + 5, ty + 5, cellS - 10, cellS - 10);

            // If hovered, draw step-by-step animated trajectory line
            if (isHovered) {
              ctx.strokeStyle = activePlayer.primary;
              ctx.lineWidth = 4;
              ctx.setLineDash([5, 4]);
              ctx.beginPath();
              const [sr, sc] = getPawnCoord(activePlayer.id, ev.startStep);
              ctx.moveTo(pad + (sc + 0.5) * cellS, pad + (sr + 0.5) * cellS);
              ev.tracedSteps.forEach(st => {
                const [pr, pc] = getPawnCoord(activePlayer.id, st);
                ctx.lineTo(pad + (pc + 0.5) * cellS, pad + (pr + 0.5) * cellS);
              });
              ctx.stroke();
            }
            ctx.restore();
          }
        });
      }

      // 6. Render All Pawns (Tumbled Agate Gemstone Pebbles matching the photo!)
      pawnHitboxes = [];
      for (let r = 0; r < 5; r++) {
        for (let c = 0; c < 5; c++) {
          // Gather all pawns on (r, c)
          const cellPawns = [];
          state.players.forEach(pl => {
            if (!pl.active) return;
            pl.pawns.forEach(pw => {
              const [pr, pc] = getPawnCoord(pl.id, pw.step);
              if (pr === r && pc === c) {
                cellPawns.push({ player: pl, pawn: pw });
              }
            });
          });

          if (cellPawns.length === 0) continue;

          const cellCx = pad + (c + 0.5) * cellS;
          const cellCy = pad + (r + 0.5) * cellS;

          // Position tokens cleanly:
          // On crossed Safe Houses (like the photo), arrange in the 4 triangles of the X!
          const count = cellPawns.length;
          cellPawns.forEach((item, idx) => {
            let px = cellCx;
            let py = cellCy;
            let radius = cellS * 0.165;

            if (isSafeCell(r, c) && count <= 4 && !(r === 2 && c === 2)) {
              // Exact 4-quadrant triangle layout inside the X cross just like the Bharataha photo!
              const offsets = [
                [0, -cellS * 0.27], // Top triangle
                [cellS * 0.27, 0],  // Right triangle
                [0, cellS * 0.27],  // Bottom triangle
                [-cellS * 0.27, 0]  // Left triangle
              ];
              px = cellCx + offsets[idx][0];
              py = cellCy + offsets[idx][1];
            } else if (count === 1) {
              px = cellCx;
              py = cellCy;
              radius = cellS * 0.19;
            } else {
              // Arrange in a ring around cell center
              const ringR = count <= 4 ? cellS * 0.24 : cellS * 0.29;
              const angle = (idx * Math.PI * 2) / count - Math.PI / 4;
              px = cellCx + Math.cos(angle) * ringR;
              py = cellCy + Math.sin(angle) * ringR;
              radius = count > 4 ? cellS * 0.13 : cellS * 0.155;
            }

            const isSelectable =
              state.phase === 'MOVE' &&
              item.player.id === state.turnIndex &&
              movablePawnIds.has(item.pawn.id);

            drawGemstonePawn(ctx, px, py, radius, item.player, item.pawn.id, isSelectable);

            pawnHitboxes.push({
              playerIdx: item.player.id,
              pawnIdx: item.pawn.id,
              x: px,
              y: py,
              r: radius + 6,
              cellR: r,
              cellC: c
            });
          });

          // If a player has formed a protected Double on an unsafe cell, draw a "2×" Double Shield badge!
          if (state.rules.doubles && !isSafeCell(r, c)) {
            const occ = getCellOccupants(r, c);
            for (let pid = 0; pid < 4; pid++) {
              if (occ[pid].length >= 2) {
                ctx.save();
                ctx.fillStyle = '#172554';
                ctx.strokeStyle = '#fbbf24';
                ctx.lineWidth = 1.5;
                ctx.beginPath();
                ctx.roundRect(cellCx - 13, cellCy - 9, 26, 18, 6);
                ctx.fill();
                ctx.stroke();
                ctx.fillStyle = '#fef3c7';
                ctx.font = 'bold 10px Inter, sans-serif';
                ctx.textAlign = 'center';
                ctx.textBaseline = 'middle';
                ctx.fillText(`🔗${occ[pid].length}×`, cellCx, cellCy);
                ctx.restore();
              }
            }
          }
        }
      }
    }

    // Draw an organic tumbled agate pebble token (like the colorful stones in the uploaded photo)
    function drawGemstonePawn(ctx, x, y, r, player, pawnId, isSelectable) {
      ctx.save();

      // Selectable pulsing halo
      if (isSelectable) {
        ctx.strokeStyle = '#f59e0b';
        ctx.lineWidth = 3.5;
        ctx.beginPath();
        ctx.arc(x, y, r + 5, 0, Math.PI * 2);
        ctx.stroke();
      }

      // Drop shadow
      ctx.shadowColor = 'rgba(0, 0, 0, 0.42)';
      ctx.shadowBlur = 6;
      ctx.shadowOffsetX = 1.5;
      ctx.shadowOffsetY = 2.5;

      // Slight organic rounded-squircle pebble shape
      ctx.translate(x, y);
      ctx.rotate((pawnId * 0.45) + player.id * 0.3);

      const grad = ctx.createRadialGradient(-r * 0.3, -r * 0.3, r * 0.1, 0, 0, r * 1.1);
      grad.addColorStop(0, player.light);
      grad.addColorStop(0.65, player.primary);
      grad.addColorStop(1, player.dark);

      ctx.fillStyle = grad;
      ctx.beginPath();
      ctx.roundRect(-r, -r * 0.88, r * 2, r * 1.76, r * 0.55);
      ctx.fill();

      // Glossy mineral highlight
      ctx.shadowColor = 'transparent';
      ctx.strokeStyle = 'rgba(255,255,255,0.65)';
      ctx.lineWidth = 1.4;
      ctx.stroke();

      ctx.fillStyle = 'rgba(255,255,255,0.32)';
      ctx.beginPath();
      ctx.ellipse(-r * 0.28, -r * 0.3, r * 0.38, r * 0.18, -0.4, 0, Math.PI * 2);
      ctx.fill();

      ctx.restore();
    }

