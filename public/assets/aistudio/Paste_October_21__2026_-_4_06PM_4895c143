    function updateUI() {
      const currentPlayer = state.players[state.turnIndex];

      // Header Turn Indicator
      const dot = document.getElementById('turnColorDot');
      dot.style.backgroundColor = currentPlayer.primary;
      document.getElementById('turnPlayerTitle').textContent =
        `${currentPlayer.name} (${currentPlayer.gemName})${currentPlayer.isAI ? ' • AI' : ''}`;

      const statusPill = document.getElementById('turnStatusPill');
      if (state.phase === 'ROLL') {
        statusPill.textContent = currentPlayer.isAI ? 'AI Casting...' : 'Cast Cowries';
        statusPill.className = 'px-2.5 py-1 rounded-full text-xs font-semibold bg-amber-500/20 text-amber-300 border border-amber-500/30';
      } else if (state.phase === 'MOVE') {
        statusPill.textContent = currentPlayer.isAI ? 'AI Moving...' : 'Select Pawn to Move';
        statusPill.className = 'px-2.5 py-1 rounded-full text-xs font-semibold bg-emerald-500/20 text-emerald-300 border border-emerald-500/30';
      } else {
        statusPill.textContent = 'Match Complete';
      }

      document.getElementById('lastRollCallout').textContent = state.lastRollText;

      // Throw button state
      const btnThrow = document.getElementById('btnThrowCowries');
      btnThrow.disabled = (state.phase !== 'ROLL' || currentPlayer.isAI);
      document.getElementById('btnThrowLabel').textContent =
        state.rollPool.some(r => !r.used) ? 'Bonus Throw! Cast Again' : 'Throw Cowrie Shells';

      // Pair mode button state
      const btnPair = document.getElementById('btnTogglePairMove');
      document.getElementById('pairModeLabel').textContent = state.pairMoveMode ? 'Move: Pair (2×)' : 'Move: Single';
      btnPair.className = state.pairMoveMode
        ? 'px-3 py-2.5 rounded-xl bg-amber-500/20 border border-amber-400 text-xs font-bold text-amber-300 transition flex items-center gap-1.5'
        : 'px-3 py-2.5 rounded-xl bg-stone-800 hover:bg-stone-700 border border-stone-700 text-xs font-semibold text-stone-300 transition flex items-center gap-1.5';

      // Render Roll Pool chips
      const poolContainer = document.getElementById('rollPoolContainer');
      const unusedCount = state.rollPool.filter(r => !r.used).length;
      document.getElementById('rollPoolHint').textContent = `${unusedCount} roll${unusedCount === 1 ? '' : 's'} available`;

      if (state.rollPool.length === 0) {
        poolContainer.innerHTML = `<span class="text-xs text-stone-500 italic">Cast the shells to generate move steps...</span>`;
      } else {
        poolContainer.innerHTML = '';
        state.rollPool.forEach(rObj => {
          const btn = document.createElement('button');
          const isSel = rObj.id === state.selectedRollId && !rObj.used;
          btn.disabled = rObj.used;
          btn.className = rObj.used
            ? 'px-3 py-1 rounded-lg bg-stone-900 border border-stone-800 text-stone-600 line-through text-xs font-bold'
            : isSel
              ? 'px-3 py-1 rounded-lg bg-amber-500 text-stone-950 font-extrabold text-xs shadow ring-2 ring-amber-300 transition'
              : 'px-3 py-1 rounded-lg bg-stone-800 hover:bg-stone-700 text-amber-300 border border-amber-500/40 font-bold text-xs transition';
          btn.textContent = rObj.value === 4 ? '4 (Chamma)' : rObj.value === 8 ? '8 (Ashta)' : `+${rObj.value}`;
          btn.addEventListener('click', () => {
            if (!rObj.used) {
              state.selectedRollId = rObj.id;
              updateUI();
              drawBoard();
            }
          });
          poolContainer.appendChild(btn);
        });
      }

      // Render 4 Player House Cards
      const grid = document.getElementById('playerCardsGrid');
      grid.innerHTML = '';
      state.players.forEach(p => {
        if (!p.active) return;
        const isTurn = p.id === state.turnIndex;
        const homeCount = p.pawns.filter(pw => pw.step === 24).length;
        const innerCount = p.pawns.filter(pw => pw.step >= 16 && pw.step < 24).length;

        const card = document.createElement('div');
        card.className = `rounded-xl p-3 border transition ${
          isTurn
            ? 'bg-stone-900 border-amber-400/80 shadow-lg shadow-amber-500/5'
            : 'bg-stone-900/60 border-stone-800 opacity-85'
        }`;

        const gateBadge = p.hasHit
          ? `<span class="text-[10px] px-1.5 py-0.5 rounded bg-emerald-950 text-emerald-300 border border-emerald-700/50">🔓 Inner Gate Open</span>`
          : `<span class="text-[10px] px-1.5 py-0.5 rounded bg-rose-950 text-rose-300 border border-rose-700/50">🔒 Need 1 Cut</span>`;

        card.innerHTML = `
          <div class="flex items-center justify-between mb-1.5">
            <div class="flex items-center gap-1.5">
              <span class="w-3 h-3 rounded-full inline-block" style="background:${p.primary}"></span>
              <span class="text-xs font-bold text-stone-100">${p.short}${p.isAI ? ' (AI)' : ''}</span>
            </div>
            ${gateBadge}
          </div>
          <div class="flex items-center justify-between text-[11px] text-stone-400 mt-2">
            <span>☸️ Home: <strong class="text-stone-100">${homeCount}/4</strong></span>
            <span>↻ Inner: <strong class="text-stone-100">${innerCount}</strong></span>
            <span>⚔️ Cuts: <strong class="text-amber-300">${p.cutsMade}</strong></span>
          </div>
        `;
        grid.appendChild(card);
      });

      // Rule summary badge
      document.getElementById('ruleActiveSummary').textContent =
        `Blood-Gate: ${state.rules.bloodGate ? 'ON' : 'OFF'} • Doubles: ${state.rules.doubles ? 'ON' : 'OFF'} • 3× Bust: ${state.rules.threeBust ? 'ON' : 'OFF'}`;
    }

    // Canvas Click & Hover Interaction
    function getCanvasMousePos(evt) {
      const rect = canvas.getBoundingClientRect();
      const scaleX = canvas.width / rect.width;
      const scaleY = canvas.height / rect.height;
      return {
        x: (evt.clientX - rect.left) * scaleX,
        y: (evt.clientY - rect.top) * scaleY
      };
    }

    canvas.addEventListener('mousemove', (evt) => {
      const pos = getCanvasMousePos(evt);
      const pad = 12;
      const cellS = (canvas.width - pad * 2) / 5;
      const c = Math.floor((pos.x - pad) / cellS);
      const r = Math.floor((pos.y - pad) / cellS);

      const tooltip = document.getElementById('boardHoverTooltip');
      if (r >= 0 && r < 5 && c >= 0 && c < 5) {
        const routeIdx = state.pathPreviewPlayer === -1 ? state.turnIndex : state.pathPreviewPlayer;
        const stepNum = PLAYER_PATHS[routeIdx].findIndex(([pr, pc]) => pr === r && pc === c);
        const zoneLabel = (r === 2 && c === 2)
          ? '☸️ Center Sanctuary (Step 24)'
          : isSafeCell(r, c)
            ? `🛡️ Safe House X (Step ${stepNum})`
            : stepNum >= 16
              ? `↻ Inner Loop (Step ${stepNum})`
              : `↺ Outer Track (Step ${stepNum})`;
        tooltip.textContent = zoneLabel;
        tooltip.classList.remove('hidden');
      } else {
        tooltip.classList.add('hidden');
      }

      // Check hovered pawn for trajectory preview
      let foundHover = null;
      for (let i = pawnHitboxes.length - 1; i >= 0; i--) {
        const hb = pawnHitboxes[i];
        const dist = Math.hypot(pos.x - hb.x, pos.y - hb.y);
        if (dist <= hb.r) {
          foundHover = { playerIdx: hb.playerIdx, pawnIdx: hb.pawnIdx };
          break;
        }
      }

      const prevHover = state.hoveredPawn;
      if (JSON.stringify(prevHover) !== JSON.stringify(foundHover)) {
        state.hoveredPawn = foundHover;
        drawBoard();
      }
    });

    canvas.addEventListener('mouseleave', () => {
      document.getElementById('boardHoverTooltip').classList.add('hidden');
      if (state.hoveredPawn) {
        state.hoveredPawn = null;
        drawBoard();
      }
    });

    canvas.addEventListener('click', (evt) => {
      if (state.phase !== 'MOVE') return;
      const currentPlayer = state.players[state.turnIndex];
      if (!currentPlayer || currentPlayer.isAI) return;
      if (!state.selectedRollId) return;

      const pos = getCanvasMousePos(evt);

      // 1. Check direct click on a current player's pawn hitbox
      for (let i = pawnHitboxes.length - 1; i >= 0; i--) {
        const hb = pawnHitboxes[i];
        if (hb.playerIdx === currentPlayer.id && Math.hypot(pos.x - hb.x, pos.y - hb.y) <= hb.r) {
          const moved = executePawnMove(currentPlayer.id, hb.pawnIdx, state.selectedRollId, state.pairMoveMode);
          if (moved) return;
        }
      }

      // 2. Also allow clicking anywhere inside the cell containing a movable pawn of the current player
      const pad = 12;
      const cellS = (canvas.width - pad * 2) / 5;
      const c = Math.floor((pos.x - pad) / cellS);
      const r = Math.floor((pos.y - pad) / cellS);
      if (r >= 0 && r < 5 && c >= 0 && c < 5) {
        for (const pw of currentPlayer.pawns) {
          const [pr, pc] = getPawnCoord(currentPlayer.id, pw.step);
          if (pr === r && pc === c) {
            const moved = executePawnMove(currentPlayer.id, pw.id, state.selectedRollId, state.pairMoveMode);
            if (moved) return;
          }
        }
      }
    });

    // Wire up Controls & Navigation Tabs
    document.getElementById('btnThrowCowries').addEventListener('click', () => {
      castCowries();
    });

    document.getElementById('btnTogglePairMove').addEventListener('click', () => {
      state.pairMoveMode = !state.pairMoveMode;
      updateUI();
      drawBoard();
    });

    document.querySelectorAll('.force-roll-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const val = parseInt(btn.getAttribute('data-force-roll'), 10);
        if (state.phase === 'MOVE') {
          // Allow adding a test roll even in MOVE phase for immediate experimentation
          state.phase = 'ROLL';
        }
        castCowries(val);
      });
    });

    document.querySelectorAll('.path-preview-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        state.pathPreviewPlayer = parseInt(btn.getAttribute('data-path-player'), 10);
        document.querySelectorAll('.path-preview-btn').forEach(b => {
          b.classList.remove('bg-amber-500', 'text-stone-950', 'font-semibold');
          b.classList.add('bg-stone-800');
        });
        btn.classList.remove('bg-stone-800');
        btn.classList.add('bg-amber-500', 'text-stone-950', 'font-semibold');
        drawBoard();
      });
    });

    document.getElementById('chkShowCoords').addEventListener('change', (e) => {
      state.showStepNumbers = e.target.checked;
      drawBoard();
    });

    // Top Navigation Tabs
    function switchTab(activeId) {
      const tabs = [
        { btn: 'tabBtnPlay', view: 'viewPlay' },
        { btn: 'tabBtnAnalysis', view: 'viewAnalysis' },
        { btn: 'tabBtnRules', view: 'viewRules' }
      ];
      tabs.forEach(t => {
        const b = document.getElementById(t.btn);
        const v = document.getElementById(t.view);
        if (t.btn === activeId) {
          b.className = 'px-2.5 py-1 rounded-md text-xs font-semibold bg-amber-500 text-stone-950 transition';
          v.classList.remove('hidden');
        } else {
          b.className = 'px-2.5 py-1 rounded-md text-xs font-semibold text-stone-300 hover:text-white transition';
          v.classList.add('hidden');
        }
      });
      if (activeId === 'tabBtnPlay') drawBoard();
    }

    document.getElementById('tabBtnPlay').addEventListener('click', () => switchTab('tabBtnPlay'));
    document.getElementById('tabBtnAnalysis').addEventListener('click', () => switchTab('tabBtnAnalysis'));
    document.getElementById('tabBtnRules').addEventListener('click', () => switchTab('tabBtnRules'));

    // Settings Modal
    document.getElementById('btnOpenSettings').addEventListener('click', () => {
      document.getElementById('settingsModal').classList.remove('hidden');
    });
    document.getElementById('btnCloseSettings').addEventListener('click', () => {
      document.getElementById('settingsModal').classList.add('hidden');
    });
    document.getElementById('btnApplySettings').addEventListener('click', () => {
      state.mode = document.getElementById('selGameMode').value;
      state.rules.bloodGate = document.getElementById('chkRuleBloodGate').checked;
      state.rules.doubles = document.getElementById('chkRuleDoubles').checked;
      state.rules.threeBust = document.getElementById('chkRuleThreeBust').checked;
      document.getElementById('settingsModal').classList.add('hidden');
      initMatch();
    });

    document.getElementById('btnToggleSound').addEventListener('click', (e) => {
      soundEnabled = !soundEnabled;
      e.currentTarget.textContent = soundEnabled ? '🔊' : '🔇';
    });

    document.getElementById('btnNewMatch').addEventListener('click', () => initMatch());
    document.getElementById('btnPlayAgainModal').addEventListener('click', () => initMatch());

    window.addEventListener('resize', () => drawBoard());

    window.onload = () => {
      renderCowrieShells(false);
      initMatch();
    };
  </script>
</body>
</html>

